{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "cli": {
      "analytics": "63e7b1ed-bbed-41d4-bb48-982212890499"
    },
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "client": {
            "root": "",
            "sourceRoot": "src",
            "projectType": "application",
            "prefix": "",
            "schematics": {
                "@schematics/angular:component": {
                    "skipTests": true,
                    "inlineTemplate": false,
                    "changeDetection": "OnPush",
                    "prefix": "",
                    "style": "scss"
                },
                "@schematics/angular:directive": {
                    "skipTests": true,
                    "prefix": ""
                },
                "@schematics/angular:service": {
                    "skipTests": true
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "preserveSymlinks": true,
                        "outputPath": "dist/client/browser",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.app.json",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets",
                            "src/manifest.json",
                            { "glob": "swagger-ui.css", "input": "node_modules/swagger-ui/dist", "output": "./assets/css" },
                            { "glob": "**/*", "input": "src/common/assets/images", "output": "./assets/images" },
                            { "glob": "**/*", "input": "node_modules/tinymce", "output": "./assets/js/tinymce" },
                            { "glob": "plyr.min.js", "input": "node_modules/plyr/dist", "output": "./assets/js" },
                            { "glob": "plyr.css", "input": "node_modules/plyr/dist", "output": "./assets/css" },
                            { "glob": "**/*", "input": "node_modules/ace-builds/src-min-noconflict", "output": "./assets/js/ace" }
                        ],
                        "styles": [
                            "src/scss/styles.scss"
                        ],
                        "scripts": [],
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "src/scss",
                                "src/common/scss"
                            ]
                        },
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "allowedCommonJsDependencies": [
                            "copy-to-clipboard",
                            "swagger-ui",
                            "deepmerge",
                            "dot-object",
                            "raven-js",
                            "slugify",
                            "fast-deep-equal",
                            "prismjs",
                            "chartist",
                            "chartist-plugin-tooltips-updated"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "extractLicenses": true
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                        "browserTarget": "client:build",
                        "proxyConfig": "proxy.conf.json"
                    },
                    "configurations": {
                        "production": {
                            "browserTarget": "client:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "client:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.spec.json",
                        "karmaConfig": "karma.conf.js",
                        "styles": [
                            "src/styles.css"
                        ],
                        "scripts": [],
                        "assets": [
                            "src/favicon.ico",
                            "src/assets",
                            "src/manifest.json"
                        ]
                    }
                },



            }
        }
    }
}
