{
    "name": "laravel/laravel",
    "description": "MTDb - Ultimate Movie&TV Database with Angular 12 and Laravel 8.3.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "cocur/slugify": "^4.0",
        "doctrine/dbal": "^3.1",
        "guzzlehttp/guzzle": "^7.2",
        "hashids/hashids": "^4.0",
        "intervention/image": "^2.5.1",
        "james-heinrich/getid3": "^1.9",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^10.10",
        "laravel/horizon": "^5.15",
        "laravel/sanctum": "^3.3",
        "laravel/scout": "^10.0",
        "laravel/slack-notification-channel": "^2.3",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.2",
        "league/color-extractor": "0.3.*",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/omnipay": "^3.0",
        "maennchen/zipstream-php": "^2.1.0",
        "matchish/laravel-scout-elasticsearch": "^7.0",
        "meilisearch/meilisearch-php": "^0.18.2",
        "omnipay/paypal": "^3.0",
        "omnipay/stripe": "^3.0",
        "pda/pheanstalk": "^4.0",
        "predis/predis": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "sentry/sentry-laravel": "^4.0",
        "teamtnt/laravel-scout-tntsearch-driver": "^13.0",
        "spatie/flysystem-dropbox": "^2.0",
        "symfony/dom-crawler": "^5.1",
        "torann/geoip": "^3.0",
        "spatie/color": "^1.2",
        "opis/closure": "^3.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13",
        "spatie/laravel-ignition": "^2.0",
        "itsgoingd/clockwork": "^5.1",
        "laravel/sail": "^1.18",
        "nunomaduro/collision": "^7.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Api\\": "app/Api/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan horizon:publish --ansi"
        ]
    }
}
